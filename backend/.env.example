# ---- Servidor ----
PORT=3333
NODE_ENV=development
# Origens permitidas no CORS, separadas por vírgula
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# ---- Banco de dados ----
# Desenvolvimento (SQLite):
DATABASE_URL="file:./dev.db"
# Produção (PostgreSQL): troque "provider" no schema.prisma e use:
# DATABASE_URL="postgresql://usuario:senha@localhost:5432/mercadinho"

# ---- Autenticação ----
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
JWT_EXPIRES_IN=7d

# ---- Pix (BR Code estático) ----
PIX_CHAVE=sua-chave-pix-aqui
PIX_NOME_RECEBEDOR="MERCADINHO XIMENES"   # máx. 25 caracteres, sem acentos
PIX_CIDADE="SOBRAL"                        # máx. 15 caracteres, sem acentos

# ---- Seed (somente desenvolvimento) ----
SEED_ADMIN_EMAIL=admin@mercadinho.com
SEED_ADMIN_SENHA=Admin@123
SEED_CLIENTE_EMAIL=cliente@mercadinho.com
SEED_CLIENTE_SENHA=Cliente@123
